# Exclude local .terraform directory
.terraform/

# Exclude .tfstate files and transient lock info files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Exclude crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exclude CLI configuration files
.terraformrc
terraform.rc
.terraform.lock.hcl